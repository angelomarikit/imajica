VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_from_project_settings

# --- Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets) ---
# Do NOT put these in VITE_* or commit them.
#   SEMAPHORE_API_KEY=...
#   SEMAPHORE_SENDER_NAME=YourApprovedSenderName
#   PAYMONGO_SECRET_KEY=...   (optional until payments go live)
#
# Auto-injected by Supabase into functions (do not set in Vite):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#
# Full setup steps: docs/SUPABASE_SETUP.md
