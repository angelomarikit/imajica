VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_from_project_settings

# --- What goes where ---
# Browser (.env above): ONLY the anon/public key. Safe to expose in the frontend.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in VITE_* — it can create/delete any Auth user.
#
# Edge Functions (auto-injected by Supabase when deployed — do not put in Vite):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#
# Branches Accounts "Create Account" calls functions/create-branch-account, which uses
# the service role on the server to create Auth users. Deploy once:
#   supabase functions deploy create-branch-account --no-verify-jwt
#
# Other Edge Function secrets (Dashboard → Edge Functions → Secrets):
#   SEMAPHORE_API_KEY=...
#   SEMAPHORE_SENDER_NAME=YourApprovedSenderName
#   PAYMONGO_SECRET_KEY=...   (optional until payments go live)
#
# Full setup steps: docs/SUPABASE_SETUP.md
